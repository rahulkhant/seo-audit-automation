# Copy this file to ".env" and fill in real values.
# ".env" itself is gitignored -- it should never be committed, since it
# holds real credentials. This ".env.example" file (with placeholder
# values only) is safe to commit, so anyone setting up the project knows
# which variables it needs.

SMTP_EMAIL_ADDRESS=your_email@example.com
SMTP_APP_PASSWORD=your_16_character_app_password
NOTIFICATION_RECIPIENT=your_email@example.com
